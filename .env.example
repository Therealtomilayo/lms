APP_ENV=local
APP_DEBUG=true
APP_NAME="Claret LMS"
APP_URL=http://localhost
APP_TIMEZONE=Africa/Lagos

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=root
DB_PASSWORD=

SESSION_LIFETIME=7200
SESSION_COOKIE_NAME=lms_session
SESSION_SECURE=false

UPLOAD_MAX_BYTES=10485760
STORAGE_PATH="storage"

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# Mail Gateway (smtp, log, mock, sendmail)
MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifications@claret.edu.ng
MAIL_FROM_NAME="Claret International School"

# SMS Gateway (termii, twilio, log, mock)
SMS_GATEWAY=log
TERMII_API_KEY=
TERMII_SENDER_ID="ClaretSch"
TERMII_BASE_URL=https://api.ng.termii.com
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Gateway (termii, twilio, log, mock)
WHATSAPP_GATEWAY=log

