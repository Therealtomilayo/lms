{
  "name": "claret-international-school-public",
  "version": "1.0.0",
  "description": "",
  "main": "tailwind.config.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./assets/css/output.css --minify",
    "build:icons": "npx esbuild assets/js/icons.src.js --bundle --minify --outfile=assets/js/icons.min.js --format=iife",
    "build": "npm run build:css && npm run build:icons",
    "watch:css": "npx @tailwindcss/cli -i ./assets/css/input.css -o ./assets/css/output.css --watch",
    "watch:icons": "npx esbuild assets/js/icons.src.js --bundle --watch --outfile=assets/js/icons.min.js --format=iife",
    "watch": "npm run watch:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.25.0",
    "lucide": "^1.32.0",
    "tailwindcss": "^4.3.3"
  }
}
